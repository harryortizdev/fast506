{
  "compilerOptions": {
    "target": "es6",  // Cambié de "es5" a "es6" porue supuestamente está obsoleto
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "node16", //temas de error cambie esto a versiones recientes y actualizadas
    "moduleResolution": "node16", // esto igual
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src"
  ]
}